# ============================================================
# ScannUs — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# The real .env file is listed in .gitignore, so it stays out of git.
#
#   cp .env.example .env
#
# ============================================================

# ----------------------------------------------------------
# Google Gemini (Generative AI)
# Get yours at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GOOGLE_API_KEY_FOR_GEMINI=

# Optional model override (default: gemini-3.6-flash)
GEMINI_MODEL=

# ----------------------------------------------------------
# Brave Search API
# Get yours at: https://api.search.brave.com/
# ----------------------------------------------------------
BRAVE_API_KEY=

# ----------------------------------------------------------
# Tavily Search API (free monthly credits, no card)
# Get yours at: https://app.tavily.com/
# ----------------------------------------------------------
TAVILY_API_KEY=

# ----------------------------------------------------------
# Exa Search API (free monthly credit, no card)
# Get yours at: https://dashboard.exa.ai/api-keys
# ----------------------------------------------------------
EXA_API_KEY=

# ----------------------------------------------------------
# OpenAI
# Get yours at: https://platform.openai.com/api-keys
# ----------------------------------------------------------
OPENAI_API_KEY=

# Optional model override (default: gpt-4o)
OPENAI_MODEL=

# ----------------------------------------------------------
# Anthropic Claude
# Get yours at: https://console.anthropic.com/
# ----------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=

# ----------------------------------------------------------
# Ollama (local LLM — no API key required)
# ----------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ----------------------------------------------------------
# Have I Been Pwned (paid — account & paste lookups)
# Get yours at: https://haveibeenpwned.com/API/Key
# ----------------------------------------------------------
HIBP_API_KEY=

# ----------------------------------------------------------
# Shodan (optional — enriches domain recon with host intel)
# Get yours at: https://account.shodan.io/
# ----------------------------------------------------------
SHODAN_API_KEY=

# ----------------------------------------------------------
# Reverse Image Search APIs (optional — Yandex + manual URLs work without keys)
# ----------------------------------------------------------
TINEYE_PUBLIC_KEY=
TINEYE_PRIVATE_KEY=
BING_VISUAL_SEARCH_KEY=

# ----------------------------------------------------------
# Cache control (set to 1 to disable persistent SQLite cache)
# ----------------------------------------------------------
SCANNUS_CACHE_DISABLE=0
