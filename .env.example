# ============================================================
# ScannUs — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# The real .env file is listed in .gitignore, so it stays out of git.
#
#   cp .env.example .env
#
# ============================================================

# ----------------------------------------------------------
# Google Gemini (Generative AI)
# Get yours at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GOOGLE_API_KEY_FOR_GEMINI=

# Optional model override (default: gemini-3.6-flash)
GEMINI_MODEL=

# ----------------------------------------------------------
# Brave Search API
# Get yours at: https://api.search.brave.com/
# ----------------------------------------------------------
BRAVE_API_KEY=

# ----------------------------------------------------------
# Tavily Search API (free monthly credits, no card)
# Get yours at: https://app.tavily.com/
# ----------------------------------------------------------
TAVILY_API_KEY=

# ----------------------------------------------------------
# Exa Search API (free monthly credit, no card)
# Get yours at: https://dashboard.exa.ai/api-keys
# ----------------------------------------------------------
EXA_API_KEY=

# ----------------------------------------------------------
# OpenAI
# Get yours at: https://platform.openai.com/api-keys
# ----------------------------------------------------------
OPENAI_API_KEY=
