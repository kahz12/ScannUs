# ============================================================
# ScannUs — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file — it is listed in .gitignore.
#
#   cp .env.example .env
#
# ============================================================

# ----------------------------------------------------------
# Google Custom Search API
# Get yours at: https://console.cloud.google.com/
# Enable: Custom Search JSON API
# ----------------------------------------------------------
API_KEY_GOOGLE=

# Programmable Search Engine ID (CX)
# Create at: https://programmablesearchengine.google.com/
SEARCH_ENGINE_ID=

# ----------------------------------------------------------
# Google Gemini (Generative AI)
# Get yours at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GOOGLE_API_KEY_FOR_GEMINI=

# ----------------------------------------------------------
# Brave Search API
# Get yours at: https://api.search.brave.com/
# ----------------------------------------------------------
BRAVE_API_KEY=

# ----------------------------------------------------------
# OpenAI
# Get yours at: https://platform.openai.com/api-keys
# ----------------------------------------------------------
OPENAI_API_KEY=
